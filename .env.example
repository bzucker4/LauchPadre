# Node application configuration. Keep real credentials outside Git.
NODE_ENV=production
LAUNCHPADRE_ACCESS_TOKEN=
WEBHOOK_SECRET=
LAUNCHPADRE_WORKSPACE_DB=./data/workspace-runtime.db
LAUNCHPADRE_CUSTOMER_GIT_ROOT=
LAUNCHPADRE_BIND_HOST=127.0.0.1
# Use loopback only behind a trusted reverse proxy on this computer.
LAUNCHPADRE_TRUST_PROXY=
LAUNCHPADRE_SEED_DEMO=false

# Public origin and account email delivery
LAUNCHPADRE_PUBLIC_ORIGIN=
LAUNCHPADRE_SUPPORT_EMAIL=
LAUNCHPADRE_PRIVACY_URL=
LAUNCHPADRE_TERMS_URL=
LAUNCHPADRE_EMAIL_FROM=
RESEND_API_KEY=
LAUNCHPADRE_REQUIRE_VERIFIED_EMAIL=false

# Test and live Stripe configurations use separate databases and credentials.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_RETURN_ORIGIN=
STRIPE_PRICE_INDIE=
STRIPE_PRICE_INDIE_ANNUAL=
# Recognized for existing subscriptions. Academic checkout is unavailable.
STRIPE_PRICE_ACADEMIC=
STRIPE_PRICE_ACADEMIC_ANNUAL=
STRIPE_PORTAL_CONFIGURATION=

# Optional legacy Python/demo integrations
DATABASE_URL=
ZENODO_ACCESS_TOKEN=
LOG_LEVEL=INFO
GIT_REPOSITORIES_ROOT=
LAUNCHPADRE_RELATIONAL_DB=./data/relational-runtime.db
