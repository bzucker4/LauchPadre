# Single-owner workspace. Use a separate database for demo and live mode.
LAUNCHPADRE_DEMO=false
# Enable only for a loopback-only local workspace.
LOCAL_ONLY=false
ADMIN_EMAIL=
ADMIN_NAME=Workspace owner
ADMIN_PASSWORD=
APP_ORIGIN=http://localhost:3000
PORT=3000
STATE_DB_PATH=./data/workspace.db

# Existing directory containing trusted Git working repositories.
GIT_REPOSITORIES_ROOT=
WEBHOOK_SECRET=

# Optional Stripe subscription checkout. Leave blank to disable.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_INDIE=
STRIPE_PRICE_ACADEMIC=

# Optional Zenodo. Start with a sandbox token; publication is a separate action.
ZENODO_BASE_URL=https://sandbox.zenodo.org
ZENODO_ACCESS_TOKEN=

# The legacy Python backend is separate and is not started by npm start.
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/launchpadre_db
