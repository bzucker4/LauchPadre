# LaunchPadre Configuration (Production Template)
DATABASE_URL=postgresql+asyncpg://<DB_USER>:<DB_PASSWORD>@localhost:5432/launchpadre_db
WEBHOOK_SECRET=<REPLACE_WITH_SECURE_HMAC_SECRET>
STRIPE_SECRET_KEY=<REPLACE_WITH_STRIPE_SECRET_KEY>
STRIPE_WEBHOOK_SECRET=<REPLACE_WITH_STRIPE_WEBHOOK_SECRET>
ZENODO_ACCESS_TOKEN=<REPLACE_WITH_ZENODO_PAT>
LOG_LEVEL=INFO
PORT=3000
GIT_REPOSITORIES_ROOT=/var/git/launchpadre

# Production API access token (32+ random characters; never commit secrets)
LAUNCHPADRE_ACCESS_TOKEN=
LAUNCHPADRE_WORKSPACE_DB=./data/workspace-runtime.db
LAUNCHPADRE_RELATIONAL_DB=./data/relational-runtime.db

# Explicit opt-in to development-only demonstration data
LAUNCHPADRE_SEED_DEMO=false
