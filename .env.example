# ==============================================================================
# LaunchPadre Configuration Template
# Copy to .env for local use or inject via your host secret manager. Never commit .env.
# ==============================================================================

# Runtime
NODE_ENV=production
PORT=3000
# Set to 1 (or proxy hop count) when deployed behind Nginx, Cloud Run, Fly.io, Render, or Caddy
TRUST_PROXY=1

# Required in production (each must be 32+ random characters)
LAUNCHPADRE_ACCESS_TOKEN=
WEBHOOK_SECRET=

# Persistent SQLite workspace database (mount on persistent storage in production)
LAUNCHPADRE_WORKSPACE_DB=./data/workspace-runtime.db

# Explicit opt-in to development-only demonstration data (ignored in production)
LAUNCHPADRE_SEED_DEMO=false

# Customer Git Checkpoints
# Existing absolute directory on persistent storage where the operator provisions
# <root>/<customer ID>/<repository>. Leave blank to disable Git checkpoints.
LAUNCHPADRE_CUSTOMER_GIT_ROOT=

# Stripe Customer Billing (supports sk_test_/rk_test_ for sandbox or sk_live_/rk_live_ for production)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Public origin returned to after Stripe Checkout/Portal (must use https:// in live mode)
STRIPE_RETURN_ORIGIN=https://app.example.com
# Stripe Price IDs matching LaunchPadre USD plans:
#   Indie Solo: $5/month, $39/year | Academic Researcher: $9/month, $69/year
STRIPE_PRICE_INDIE=
STRIPE_PRICE_INDIE_ANNUAL=
STRIPE_PRICE_ACADEMIC=
STRIPE_PRICE_ACADEMIC_ANNUAL=

# Zenodo Academic Archival (Academic Researcher plan)
# Allowed values: https://sandbox.zenodo.org (default) or https://zenodo.org
ZENODO_BASE_URL=https://sandbox.zenodo.org
ZENODO_ACCESS_TOKEN=
